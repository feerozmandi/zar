# ══════════════════════════════════════════════════════════════════════════════
# تنظیمات مشترک مونورپوی Xennic — نسخه‌ی توسعه
#   ۱) cp .env.example .env
#   ۲) pnpm setup        (تولید کلیدهای تصادفی و ساخت .env محلی)
# هر بخش مقادیر اختصاصی خود را در apps/<name>/.env.example دارد؛ این فایل فقط
# متغیرهای مشترک (دیتابیس، Redis، دامنه و رمزنگاری) را نگه می‌دارد.
# ══════════════════════════════════════════════════════════════════════════════

# ── محیط ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── دامنه و پروتکل (پیش‌نمایش/استقرار) ───────────────────────────────────────
PUBLIC_HOST=localhost
XENNIC_SITE_URL=http://localhost:3000
XENNIC_API_URL=http://localhost:4000/api

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=xennic
POSTGRES_PASSWORD=***
POSTGRES_DB=xennic
POSTGRES_PORT=5432
DATABASE_URL=postgresql://xennic:xennic@localhost:5432/xennic?schema=public
DB_POOL_MAX=10

# ── Redis (کش + صف BullMQ) ───────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
BULLMQ_CONCURRENCY=4

# ── احراز هویت و رمزنگاری ────────────────────────────────────────────────────
# JWT_SECRET: حداقل ۳۲ نویسه   |   ENCRYPTION_KEY: ۶۴ کاراکتر هگز (۳۲ بایت)
JWT_SECRET=
ENCRYPTION_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── دروازه‌ی هوش مصنوعی ───────────────────────────────────────────────────────
GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com
GITHUB_MODELS_TOKEN=

# ── پورت‌های سرویس‌ها ─────────────────────────────────────────────────────────
WEB_PORT=3000
API_PORT=4000
OCR_PORT=8000
UPLOAD_MAX_MB=10
