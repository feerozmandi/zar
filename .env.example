# ==============================================================================
# Xennic Platform Environment Variables Template
# Zar Noor Niroo Yekta (زر نور نیرو یکتا)
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
FRONTEND_PORT=3000

# Next.js Public Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_NAME="Xennic | پلتفرم هوشمند انرژی و مهندسی برق"

# Database (PostgreSQL)
DATABASE_URL=postgresql://xennic_user:xennic_secure_pass@localhost:5432/xennic_db?schema=public
POSTGRES_USER=xennic_user
POSTGRES_PASSWORD=xennic_secure_pass
POSTGRES_DB=xennic_db
POSTGRES_PORT=5432

# Redis Cache & BullMQ Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=replace_with_a_super_secure_random_jwt_secret_minimum_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_super_secure_refresh_token_secret_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# BYOK (Bring Your Own Key) AES-256 Encryption Key
# 32 bytes hex string for server-side AES-256-GCM encryption of user API keys
BYOK_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI Providers & Model Gateways
GITHUB_MODELS_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Storage & OCR Service
OCR_MICROSERVICE_URL=http://localhost:5000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# Payment Gateway (Zarinpal / Saman)
ZARINPAL_MERCHANT_ID=
PAYMENT_CALLBACK_URL=http://localhost:3000/billing/verify
