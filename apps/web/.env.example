# ─── apps/web — Next.js App Router ───────────────────────────────────────────
NODE_ENV=development
PORT=3000

# URL داخلی که سرور/روتر Next برای فراخوان API استفاده می‌کند (در شبکه‌ی داکر: http://xennic-api:4000/api/v1)
API_INTERNAL_URL=http://localhost:4000/api/v1

# آدرسی که مرورگر می‌بیند؛ مسیر پیش‌فرض از پروکسی هم‌ریشه‌ی apps/web/src/app/api/proxy استفاده می‌کند
NEXT_PUBLIC_API_URL=/api/proxy
# در استقرار واقعی، پیش از build به دامنه نهایی HTTPS تغییر دهید (canonical / sitemap / Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# فقط برای نمایش داخل iframe محیط Arena، در زمان build و اجرای dev فعال شود.
# استقرار عادی باید این مقدار را false نگه دارد تا حفاظت SAMEORIGIN برقرار باشد.
ARENA_PREVIEW=false
