# ─── apps/api — NestJS Core Gateway ──────────────────────────────────────────
# این فایل نمونه است؛ مقدار واقعی را در محیط اجرا (یا GitHub Secrets) بگذارید.
NODE_ENV=development
LOG_LEVEL=debug

HOST=0.0.0.0
PORT=4000
API_GLOBAL_PREFIX=/api
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=true
SWAGGER_ENABLED=true

# دیتابیس (همان مقداری که در ریشه/.env استفاده می‌شود)
DATABASE_URL=postgresql://xennic:xennic@localhost:5432/xennic?schema=public

# احراز هویت — برای تولید: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# رمزنگاری کلیدهای BYOK با AES-256-GCM (۶۴ کاراکتر هگز)
ENCRYPTION_KEY=

# صف و کش
REDIS_URL=redis://localhost:6379
BULLMQ_CONCURRENCY=4

# مایکروسرویس OCR
OCR_SERVICE_URL=http://localhost:8000

# دروازه‌ی هوش مصنوعی (سطح سیستم — رایگان)
GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com
GITHUB_MODELS_TOKEN=

UPLOAD_MAX_MB=10
# مسیر ذخیره فایل‌های آپلودی (نسبی به apps/api)
UPLOAD_DIR=var/uploads
